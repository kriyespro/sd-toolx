{% extends "base.jinja" %}
{% block body %}

{# ── HEADER ─────────────────────────────────────────────────────────────────── #}
<header class="border-b border-gray-100 dark:border-gray-800/80 bg-white/80 dark:bg-gray-950/80 backdrop-blur-md sticky top-0 z-50 shadow-sm shadow-black/5">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    {# Logo #}
    <a href="{{ url('home') }}" class="flex items-center gap-2.5 flex-shrink-0">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <span class="font-extrabold text-lg tracking-tight text-gray-900 dark:text-white">{{ site_name }}</span>
    </a>

    {# Desktop Nav #}
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      <a href="{{ url('tools:index') }}" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Tools</a>
      <a href="{{ url('billing:pricing') }}" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Pricing</a>
      <a href="{{ url('blog:list') }}" class="px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Blog</a>
    </nav>

    {# Right side actions #}
    <div class="flex items-center gap-2">
      <button type="button"
        @click="dark = !dark; localStorage.setItem('dark', dark)"
        class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Toggle dark mode">
        <svg x-show="!dark" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        <svg x-show="dark" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      </button>
      {% if request.user.is_authenticated %}
        <a href="{{ url('dashboard:home') }}"
           class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-950/50 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Dashboard
        </a>
      {% else %}
        <a href="{{ url('account_login') }}"
           class="hidden md:inline-block text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          Log in
        </a>
        <a href="{{ url('users:register') }}"
           class="inline-flex items-center gap-1.5 text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl shadow-sm hover:shadow-indigo-500/25 transition-all duration-200">
          Sign up free
        </a>
      {% endif %}
    </div>
  </div>
</header>

<main>
  {% block content %}{% endblock %}
</main>

{# ── FOOTER ─────────────────────────────────────────────────────────────────── #}
<footer class="border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 pt-14 pb-8 mt-8">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">
      {# Brand #}
      <div class="col-span-2 md:col-span-1">
        <a href="{{ url('home') }}" class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <span class="font-extrabold text-lg text-gray-900 dark:text-white">{{ site_name }}</span>
        </a>
        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
          Free PDF &amp; image tools for everyone. No signup, no watermarks, no ads.
        </p>
        <p class="text-xs text-gray-400 dark:text-gray-500">Made with ♥ in India</p>
      </div>

      {# PDF Tools #}
      <div>
        <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm mb-4">PDF Tools</h4>
        <ul class="space-y-2.5">
          {% for slug, name in [
            ('tools:compress-pdf', 'Compress PDF'),
            ('tools:merge-pdf', 'Merge PDF'),
            ('tools:split-pdf', 'Split PDF'),
            ('tools:pdf-to-jpg', 'PDF to JPG'),
            ('tools:sign-pdf', 'Sign PDF'),
            ('tools:protect-pdf', 'Protect PDF'),
          ] %}
          <li><a href="{{ url(slug) }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{{ name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# Image & Utils #}
      <div>
        <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm mb-4">Image & Utilities</h4>
        <ul class="space-y-2.5">
          {% for slug, name in [
            ('tools:compress-image', 'Compress Image'),
            ('tools:remove-background', 'Remove Background'),
            ('tools:resize-image', 'Resize Image'),
            ('tools:convert-image', 'Convert Image'),
            ('tools:qr-generator', 'QR Generator'),
            ('tools:barcode-generator', 'Barcode Generator'),
          ] %}
          <li><a href="{{ url(slug) }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{{ name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# Company #}
      <div>
        <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm mb-4">Company</h4>
        <ul class="space-y-2.5">
          <li><a href="{{ url('billing:pricing') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Pricing</a></li>
          <li><a href="{{ url('blog:list') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Blog</a></li>
          <li><a href="{{ url('tools:index') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">All Tools</a></li>
          {% if not request.user.is_authenticated %}
          <li><a href="{{ url('users:register') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Sign up free</a></li>
          <li><a href="{{ url('account_login') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Log in</a></li>
          {% else %}
          <li><a href="{{ url('dashboard:home') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Dashboard</a></li>
          {% endif %}
        </ul>
      </div>
    </div>

    {# Bottom bar #}
    <div class="border-t border-gray-100 dark:border-gray-800 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        &copy; 2026 {{ site_name }}. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-xs text-gray-400 dark:text-gray-500">
        <span>Files auto-deleted after 2 hours</span>
        <span>·</span>
        <span>No data sold, ever</span>
        <span>·</span>
        <span>SSL secured</span>
      </div>
    </div>
  </div>
</footer>

{% endblock %}
