{% extends "layouts/marketing.jinja" %}
{% block title %}Create your free account — {{ site_name }}{% endblock %}
{% block meta_description %}Sign up for {{ site_name }} — free PDF and image tools. No credit card required.{% endblock %}

{% block extra_head %}
<style>
  .input-field {
    width: 100%;
    padding: .625rem .875rem;
    font-size: .875rem;
    border: 1px solid #e5e7eb;
    border-radius: .75rem;
    background: #fff;
    color: #111827;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .input-field:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); }
  .dark .input-field { background: #111827; border-color: #374151; color: #f9fafb; }
  .dark .input-field:focus { border-color: #818cf8; box-shadow: 0 0 0 3px rgba(129,140,248,.15); }
  .input-field.error { border-color: #f87171; }
  .dark .input-field.error { border-color: #f87171; }
  @keyframes fade-up { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
  .animate-in { animation: fade-up .35s ease both; }
  .benefit-item { animation: fade-up .4s ease both; }
</style>
{% endblock %}

{% block content %}
<div class="min-h-[calc(100vh-4rem)] flex">

  {# ── Left panel — benefits ─────────────────────────────────────────────── #}
  <div class="hidden lg:flex flex-col justify-center px-14 xl:px-20 w-[48%] bg-gradient-to-br from-indigo-600 via-violet-600 to-indigo-800 relative overflow-hidden">
    {# Decorative circles #}
    <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-16 -right-16 w-56 h-56 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute top-1/2 right-0 w-40 h-40 rounded-full bg-white/5 pointer-events-none"></div>

    <div class="relative z-10 max-w-sm">
      {# Logo mark #}
      <div class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur flex items-center justify-center mb-8 shadow-lg">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>

      <h2 class="text-3xl font-extrabold text-white leading-tight mb-3">
        Everything you need.<br>
        <span class="text-indigo-200">All for free.</span>
      </h2>
      <p class="text-indigo-200 text-base mb-10 leading-relaxed">
        Create an account to unlock higher limits and save your work history.
      </p>

      {# Benefits list #}
      <ul class="space-y-4">
        {% for benefit in [
          ('Compress, merge & split PDFs instantly', 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'),
          ('Remove image backgrounds with AI', 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'),
          ('44+ tools — no watermarks, no ads', 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z'),
          ('Files deleted after 2 hours', 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'),
        ] %}
        <li class="benefit-item flex items-start gap-3" style="animation-delay: {{ loop.index0 * 80 }}ms">
          <div class="w-8 h-8 rounded-xl bg-white/15 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ benefit[1] }}"/>
            </svg>
          </div>
          <span class="text-indigo-100 text-sm leading-relaxed pt-1.5">{{ benefit[0] }}</span>
        </li>
        {% endfor %}
      </ul>

      {# Social proof #}
      <div class="mt-12 pt-8 border-t border-white/15">
        <div class="flex items-center gap-3 mb-2">
          <div class="flex -space-x-2">
            {% for color in ['bg-pink-400', 'bg-yellow-400', 'bg-green-400', 'bg-blue-400'] %}
            <div class="w-7 h-7 rounded-full {{ color }} border-2 border-indigo-700 flex items-center justify-center text-xs font-bold text-white">
              {{ ['S','A','R','M'][loop.index0] }}
            </div>
            {% endfor %}
          </div>
          <p class="text-indigo-200 text-sm"><span class="text-white font-semibold">10,000+</span> users</p>
        </div>
        <div class="flex items-center gap-1">
          {% for _ in range(5) %}
          <svg class="w-4 h-4 text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          {% endfor %}
          <span class="text-indigo-200 text-xs ml-1">Loved by thousands</span>
        </div>
      </div>
    </div>
  </div>

  {# ── Right panel — form ────────────────────────────────────────────────── #}
  <div class="flex-1 flex items-center justify-center px-4 py-12 bg-gray-50 dark:bg-gray-950">
    <div class="w-full max-w-sm animate-in">

      {# Mobile logo (hidden on lg) #}
      <div class="flex items-center gap-2 justify-center mb-8 lg:hidden">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <span class="font-extrabold text-lg text-gray-900 dark:text-white tracking-tight">{{ site_name }}</span>
      </div>

      {# Heading #}
      <div class="mb-7 text-center lg:text-left">
        <h1 class="text-2xl font-extrabold text-gray-900 dark:text-white tracking-tight">Create your free account</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1.5">No credit card required. Cancel anytime.</p>
      </div>

      {# Card #}
      <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl shadow-lg shadow-black/5 dark:shadow-black/30 p-7">

        {# Non-field errors #}
        {% if form.non_field_errors() %}
        <div class="text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/40 border border-red-100 dark:border-red-900 rounded-xl px-3.5 py-2.5 mb-5">
          {% for error in form.non_field_errors() %}{{ error }}{% endfor %}
        </div>
        {% endif %}

        <form method="post" class="space-y-4" x-data="{ showPw: false, showPw2: false }">
          <input type="hidden" name="csrfmiddlewaretoken" value="{{ get_csrf(request) }}">

          {# Email #}
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="id_email">Email address</label>
            <input
              type="email"
              name="email"
              id="id_email"
              value="{{ form.email.value() or '' }}"
              autocomplete="email"
              autofocus
              placeholder="you@example.com"
              required
              class="input-field {{ 'error' if form.email.errors else '' }}">
            {% if form.email.errors %}
            <p class="mt-1.5 text-xs text-red-500 dark:text-red-400">{{ form.email.errors|join(', ') }}</p>
            {% endif %}
          </div>

          {# Password #}
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="id_password1">Password</label>
            <div class="relative">
              <input
                :type="showPw ? 'text' : 'password'"
                name="password1"
                id="id_password1"
                autocomplete="new-password"
                placeholder="Min. 8 characters"
                required
                class="input-field {{ 'error' if form.password1.errors else '' }}">
              <button type="button" @click="showPw = !showPw"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                <svg x-show="!showPw" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg x-show="showPw" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
            {% if form.password1.errors %}
            <p class="mt-1.5 text-xs text-red-500 dark:text-red-400">{{ form.password1.errors|join(', ') }}</p>
            {% endif %}
          </div>

          {# Confirm password #}
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="id_password2">Confirm password</label>
            <div class="relative">
              <input
                :type="showPw2 ? 'text' : 'password'"
                name="password2"
                id="id_password2"
                autocomplete="new-password"
                placeholder="Re-enter password"
                required
                class="input-field {{ 'error' if form.password2.errors else '' }}">
              <button type="button" @click="showPw2 = !showPw2"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                <svg x-show="!showPw2" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg x-show="showPw2" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
            {% if form.password2.errors %}
            <p class="mt-1.5 text-xs text-red-500 dark:text-red-400">{{ form.password2.errors|join(', ') }}</p>
            {% endif %}
          </div>

          {# Submit #}
          <button type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-[.98] text-white font-semibold text-sm py-2.5 px-4 rounded-xl shadow-sm hover:shadow-indigo-500/25 transition-all duration-200 mt-1">
            Create free account
          </button>
        </form>

        {# Divider + login #}
        <div class="mt-5 text-center">
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Already have an account?
            <a href="{{ url('account_login') }}" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline ml-1">Sign in</a>
          </p>
        </div>
      </div>

      {# Terms & trust #}
      <p class="text-center text-xs text-gray-400 dark:text-gray-500 mt-5 leading-relaxed px-2">
        By creating an account you agree to our
        <a href="#" class="hover:text-indigo-500 underline underline-offset-2">Terms</a> and
        <a href="#" class="hover:text-indigo-500 underline underline-offset-2">Privacy Policy</a>.
        No spam, ever.
      </p>

      {# Trust bar #}
      <div class="flex items-center justify-center gap-5 mt-5 text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
          SSL secured
        </span>
        <span>·</span>
        <span>No credit card</span>
        <span>·</span>
        <span>Free forever</span>
      </div>
    </div>
  </div>

</div>
{% endblock %}
