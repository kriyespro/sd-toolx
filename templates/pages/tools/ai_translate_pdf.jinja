{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".pdf" %}
{% include "components/upload_zone.jinja" %}
<div class="mt-4">
  <label class="block text-sm font-medium">Translate to</label>
  <select name="target_lang" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 mt-1">
    <option value="hi">Hindi (हिंदी)</option>
    <option value="ta">Tamil (தமிழ்)</option>
    <option value="te">Telugu (తెలుగు)</option>
    <option value="bn">Bengali (বাংলা)</option>
    <option value="mr">Marathi (मराठी)</option>
    <option value="gu">Gujarati (ગુજરાતી)</option>
    <option value="es">Spanish</option>
    <option value="fr">French</option>
    <option value="de">German</option>
    <option value="zh">Chinese (Simplified)</option>
    <option value="ar">Arabic</option>
    <option value="pt">Portuguese</option>
  </select>
  <p class="text-xs text-gray-500 mt-1">Powered by AI. Best for text-based PDFs (not scanned images).</p>
</div>
{% endblock %}
{% block submit_label %}Translate PDF{% endblock %}
{% block processing_text %}Translating with AI… this may take a minute{% endblock %}
