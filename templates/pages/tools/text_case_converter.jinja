{% extends "layouts/marketing.jinja" %}
{% block title %}Text Case Converter Free | SD-Toolx{% endblock %}
{% block content %}
<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-2">Text Case Converter</h1>
  <p class="text-gray-500 mb-6">Convert text to UPPERCASE, lowercase, Title Case, camelCase, and more.</p>
  <textarea id="input" rows="6" placeholder="Paste your text here…"
    class="w-full border border-gray-300 dark:border-gray-700 rounded-xl px-4 py-3 bg-white dark:bg-gray-900 text-sm resize-y mb-4"
    oninput="convert()"></textarea>
  <div class="flex flex-wrap gap-2 mb-4">
    <button onclick="set('upper')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">UPPERCASE</button>
    <button onclick="set('lower')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">lowercase</button>
    <button onclick="set('title')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">Title Case</button>
    <button onclick="set('sentence')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">Sentence case</button>
    <button onclick="set('camel')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">camelCase</button>
    <button onclick="set('snake')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">snake_case</button>
    <button onclick="set('kebab')" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm hover:bg-indigo-100">kebab-case</button>
  </div>
  <div class="relative">
    <textarea id="output" rows="6" readonly
      class="w-full border border-gray-300 dark:border-gray-700 rounded-xl px-4 py-3 bg-gray-50 dark:bg-gray-900 text-sm resize-y"></textarea>
    <button onclick="copyOut()" class="absolute top-2 right-2 px-3 py-1 bg-indigo-600 text-white rounded-lg text-xs hover:bg-indigo-700" id="copy-btn">Copy</button>
  </div>
</div>
<script>
let mode = 'upper';
function set(m) { mode = m; convert(); }
function convert() {
  const t = document.getElementById('input').value;
  let out = t;
  if (mode === 'upper') out = t.toUpperCase();
  else if (mode === 'lower') out = t.toLowerCase();
  else if (mode === 'title') out = t.replace(/\w\S*/g, w => w.charAt(0).toUpperCase() + w.substr(1).toLowerCase());
  else if (mode === 'sentence') out = t.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, c => c.toUpperCase());
  else if (mode === 'camel') out = t.toLowerCase().replace(/[^a-zA-Z0-9]+(.)/g, (_, c) => c.toUpperCase());
  else if (mode === 'snake') out = t.trim().toLowerCase().replace(/\s+/g, '_');
  else if (mode === 'kebab') out = t.trim().toLowerCase().replace(/\s+/g, '-');
  document.getElementById('output').value = out;
}
function copyOut() {
  navigator.clipboard.writeText(document.getElementById('output').value).then(() => {
    document.getElementById('copy-btn').textContent = 'Copied!';
    setTimeout(() => document.getElementById('copy-btn').textContent = 'Copy', 2000);
  });
}
</script>
{% endblock %}
