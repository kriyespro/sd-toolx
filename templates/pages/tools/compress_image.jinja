{% extends "pages/tools/_tool_base.jinja" %}
{% block processing_text %}Compressing to ~90% smaller…{% endblock %}
{% block tool_form %}
{% set accept = ".jpg,.jpeg,.png,.webp" %}
{% include "components/upload_zone.jinja" %}

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-4 items-end">
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Compression</label>
    <select name="mode" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm bg-white dark:bg-gray-900">
      <option value="target90" selected>~90% smaller (recommended)</option>
      <option value="balanced">Balanced (~50%)</option>
      <option value="lossless">Lossless (no quality loss)</option>
      <option value="maximum">Maximum size cut</option>
    </select>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Output</label>
    <select name="output_format" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm bg-white dark:bg-gray-900">
      <option value="auto" selected>WebP / JPEG (best size)</option>
      <option value="original">Keep original type</option>
    </select>
  </div>
  <div class="sm:col-span-2 lg:col-span-2">
    <button type="submit" id="tool-submit-btn"
      class="w-full bg-indigo-600 text-white py-2.5 rounded-xl font-semibold hover:bg-indigo-700 transition disabled:opacity-60 min-h-[42px]">
      <span id="tool-submit-label">Compress ~90%</span>
      <span id="tool-submit-loading" class="hidden">Processing…</span>
    </button>
  </div>
</div>
<p class="text-xs text-gray-500 mt-2">~90% mode uses WebP/JPEG at lower quality + resize if needed. Preview before sharing.</p>
{% endblock %}
{% block tool_submit_row %}{% endblock %}
