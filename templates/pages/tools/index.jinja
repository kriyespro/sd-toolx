{% extends "layouts/marketing.jinja" %}
{% block title %}All {{ tools|length }} Free Tools — {{ site_name }}{% endblock %}
{% block meta_description %}{{ tools|length }} free online PDF and image tools. Compress, merge, split, convert PDFs. Remove backgrounds, resize images. No signup required.{% endblock %}

{% block extra_head %}
<style>
  @keyframes fade-up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
  .animate-in { animation: fade-up .4s ease both; }
  .tool-card { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .tool-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(99,102,241,.13); border-color: rgba(99,102,241,.4) !important; }
  .dark .tool-card:hover { box-shadow: 0 8px 24px rgba(99,102,241,.22); }
  .cat-btn { transition: all .15s ease; }
  .cat-btn.active { background: #4f46e5; color: #fff; border-color: #4f46e5; }
  .dark .cat-btn.active { background: #6366f1; border-color: #6366f1; }
</style>
{% endblock %}

{% block content %}

{# ── PAGE HERO ──────────────────────────────────────────────────────────────── #}
<div class="border-b border-gray-100 dark:border-gray-800 bg-gradient-to-b from-indigo-50/60 dark:from-indigo-950/20 to-transparent pt-14 pb-10 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 bg-white dark:bg-gray-900 border border-indigo-100 dark:border-indigo-900 rounded-full px-4 py-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-5 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
      {{ tools|length }} tools — all free, no signup
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
      Every tool. <span style="background:linear-gradient(135deg,#6366f1,#8b5cf6,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Zero barriers.</span>
    </h1>
    <p class="text-gray-500 dark:text-gray-400 text-lg max-w-xl mx-auto">Pick a tool, upload your file, download the result. That's it.</p>
  </div>
</div>

{# ── MAIN CONTENT ───────────────────────────────────────────────────────────── #}
<div class="max-w-6xl mx-auto px-4 py-10" x-data="toolFilter()" x-init="init()">

  {# ── Search + Filter bar ── #}
  <div class="flex flex-col sm:flex-row gap-3 mb-8 items-start sm:items-center">
    {# Search #}
    <div class="relative flex-1 max-w-sm">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" placeholder="Search tools…"
        x-model="query"
        @input="filter()"
        class="w-full pl-9 pr-4 py-2.5 text-sm border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition">
    </div>

    {# Category filters #}
    <div class="flex flex-wrap gap-2">
      <button @click="setCategory('all')" :class="category === 'all' ? 'active' : ''"
        class="cat-btn px-4 py-2 text-sm font-medium border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:border-indigo-400">
        All <span class="ml-1 text-xs opacity-70" x-text="counts.all"></span>
      </button>
      <button @click="setCategory('pdf')" :class="category === 'pdf' ? 'active' : ''"
        class="cat-btn px-4 py-2 text-sm font-medium border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:border-indigo-400">
        📄 PDF <span class="ml-1 text-xs opacity-70" x-text="counts.pdf"></span>
      </button>
      <button @click="setCategory('image')" :class="category === 'image' ? 'active' : ''"
        class="cat-btn px-4 py-2 text-sm font-medium border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:border-indigo-400">
        🖼️ Image <span class="ml-1 text-xs opacity-70" x-text="counts.image"></span>
      </button>
      <button @click="setCategory('utility')" :class="category === 'utility' ? 'active' : ''"
        class="cat-btn px-4 py-2 text-sm font-medium border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:border-indigo-400">
        ⚙️ Utility <span class="ml-1 text-xs opacity-70" x-text="counts.utility"></span>
      </button>
    </div>
  </div>

  {# ── Results count ── #}
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6" x-show="query || category !== 'all'">
    <span x-text="visible"></span> tool<span x-show="visible !== 1">s</span> found
  </p>

  {# ── Tools grid ── #}
  {# Build JSON data for Alpine #}
  <script>
    window.__TOOLS__ = [
      {% for tool in tools %}
      {
        slug: {{ (tool.slug)|tojson }},
        name: {{ (tool.name)|tojson }},
        description: {{ (tool.description)|tojson }},
        category: {{ (tool.category)|tojson }},
        url: {{ (url(tool.url_name))|tojson }},
      },
      {% endfor %}
    ];
  </script>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="tools-grid">
    {% for tool in tools %}
    {% set cat_colors = {
      'pdf': ('bg-indigo-50 dark:bg-indigo-950/50', 'text-indigo-500 dark:text-indigo-400'),
      'image': ('bg-violet-50 dark:bg-violet-950/50', 'text-violet-500 dark:text-violet-400'),
      'utility': ('bg-teal-50 dark:bg-teal-950/50', 'text-teal-500 dark:text-teal-400'),
    } %}
    {% set icon_bg = cat_colors.get(tool.category, ('bg-gray-100 dark:bg-gray-800', 'text-gray-500'))[0] %}
    {% set icon_color = cat_colors.get(tool.category, ('bg-gray-100 dark:bg-gray-800', 'text-gray-500'))[1] %}
    <a href="{{ url(tool.url_name) }}"
       data-cat="{{ tool.category }}"
       data-name="{{ tool.name|lower }}"
       data-desc="{{ tool.description|lower }}"
       class="tool-card group bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-sm animate-in"
       style="animation-delay: {{ loop.index0 * 20 }}ms">
      <div class="flex items-start justify-between">
        <div class="w-10 h-10 rounded-xl {{ icon_bg }} flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 {{ icon_color }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {% if tool.category == 'pdf' %}
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            {% elif tool.category == 'image' %}
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            {% else %}
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            {% endif %}
          </svg>
        </div>
        <svg class="w-3.5 h-3.5 text-gray-300 dark:text-gray-600 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
      <div>
        <h2 class="font-semibold text-gray-900 dark:text-gray-100 text-sm leading-snug mb-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{{ tool.name }}</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{{ tool.description }}</p>
      </div>
      <div class="mt-auto pt-1">
        <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full
          {% if tool.category == 'pdf' %}bg-indigo-50 dark:bg-indigo-950/50 text-indigo-500 dark:text-indigo-400
          {% elif tool.category == 'image' %}bg-violet-50 dark:bg-violet-950/50 text-violet-500 dark:text-violet-400
          {% else %}bg-teal-50 dark:bg-teal-950/50 text-teal-500 dark:text-teal-400{% endif %}">
          {{ tool.category }}
        </span>
      </div>
    </a>
    {% endfor %}
  </div>

  {# No results #}
  <div x-show="visible === 0" class="text-center py-16">
    <div class="w-16 h-16 rounded-2xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <p class="font-semibold text-gray-700 dark:text-gray-300 mb-1">No tools found</p>
    <p class="text-sm text-gray-400">Try a different search term or category</p>
    <button @click="query=''; setCategory('all')" class="mt-4 text-sm text-indigo-600 dark:text-indigo-400 hover:underline">Clear filters</button>
  </div>

</div>

<script>
function toolFilter() {
  return {
    query: '',
    category: 'all',
    visible: {{ tools|length }},
    counts: { all: {{ tools|length }}, pdf: 0, image: 0, utility: 0 },
    cards: [],
    init() {
      this.cards = Array.from(document.querySelectorAll('[data-cat]'));
      this.counts.pdf = this.cards.filter(c => c.dataset.cat === 'pdf').length;
      this.counts.image = this.cards.filter(c => c.dataset.cat === 'image').length;
      this.counts.utility = this.cards.filter(c => c.dataset.cat === 'utility').length;
    },
    setCategory(cat) {
      this.category = cat;
      this.filter();
    },
    filter() {
      const q = this.query.toLowerCase().trim();
      let count = 0;
      this.cards.forEach(card => {
        const matchCat = this.category === 'all' || card.dataset.cat === this.category;
        const matchQ = !q || card.dataset.name.includes(q) || card.dataset.desc.includes(q);
        const show = matchCat && matchQ;
        card.style.display = show ? '' : 'none';
        if (show) count++;
      });
      this.visible = count;
    }
  }
}
</script>

{% endblock %}
