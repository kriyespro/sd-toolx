{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".jpg,.jpeg,.png,.webp,.bmp,.gif" %}
{% include "components/upload_zone.jinja" %}
<div class="mt-4">
  <label class="block text-sm font-medium">Convert to</label>
  <select name="to_format" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 mt-1">
    <option value="jpg">JPG</option>
    <option value="png">PNG</option>
    <option value="webp">WebP</option>
    <option value="bmp">BMP</option>
    <option value="gif">GIF</option>
  </select>
</div>
{% endblock %}
{% block submit_label %}Convert Image{% endblock %}
