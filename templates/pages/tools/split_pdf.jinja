{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".pdf" %}
{% include "components/upload_zone.jinja" %}
<label class="block text-sm font-medium mt-4">Pages (e.g. 1-3, 5, 7-10)</label>
<input type="text" name="pages" value="1" placeholder="1-3, 5"
  class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
<input type="hidden" name="mode" value="range">
{% endblock %}
{% block submit_label %}Split PDF{% endblock %}
