{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".pdf" %}
{% set multiple = true %}
<div class="space-y-3">
  <div>
    <label class="block text-sm font-medium mb-1">File 1 (original)</label>
    <input type="file" name="files" accept=".pdf"
      class="block w-full text-sm border border-gray-300 dark:border-gray-700 rounded-lg p-2 bg-white dark:bg-gray-900 cursor-pointer">
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">File 2 (revised)</label>
    <input type="file" name="files" accept=".pdf"
      class="block w-full text-sm border border-gray-300 dark:border-gray-700 rounded-lg p-2 bg-white dark:bg-gray-900 cursor-pointer">
  </div>
</div>
<p class="text-xs text-gray-500 mt-2">Pages shown side-by-side. Differences visible visually.</p>
{% endblock %}
{% block submit_label %}Compare PDFs{% endblock %}
