{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".pdf" %}
{% include "components/upload_zone.jinja" %}
<label class="block text-sm font-medium mt-4">Rotation</label>
<select name="angle" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
  <option value="90">90° clockwise</option>
  <option value="180">180°</option>
  <option value="270">270° clockwise</option>
</select>
{% endblock %}
{% block submit_label %}Rotate PDF{% endblock %}
