{% extends "pages/tools/_tool_base.jinja" %}
{% block tool_form %}
{% set accept = ".pdf" %}
{% include "components/upload_zone.jinja" %}
<div class="mt-4 space-y-3">
  <div>
    <label class="block text-sm font-medium">Watermark text</label>
    <input type="text" name="text" value="CONFIDENTIAL"
      class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 mt-1">
  </div>
  <div class="grid grid-cols-3 gap-3">
    <div>
      <label class="block text-sm font-medium">Opacity</label>
      <select name="opacity" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 mt-1">
        <option value="0.15">Light</option>
        <option value="0.30" selected>Medium</option>
        <option value="0.60">Dark</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium">Rotation</label>
      <select name="rotation" class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 mt-1">
        <option value="0">Horizontal</option>
        <option value="45" selected>Diagonal 45°</option>
        <option value="-45">Diagonal -45°</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium">Color</label>
      <input type="color" name="color" value="#888888"
        class="w-full h-10 border border-gray-300 dark:border-gray-700 rounded-lg mt-1 cursor-pointer">
    </div>
  </div>
</div>
{% endblock %}
{% block submit_label %}Add Watermark{% endblock %}
