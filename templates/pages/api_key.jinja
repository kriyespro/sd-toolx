{% extends "layouts/dashboard.jinja" %}
{% block title %}API Key — SD-Toolx{% endblock %}

{% block dashboard_content %}
<h1 class="text-2xl font-bold mb-6">API Access</h1>

{% if has_api %}
<div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 p-6 mb-6">
  <h2 class="text-lg font-semibold mb-1">Your API Key</h2>
  <p class="text-sm text-gray-500 mb-4">Keep this secret. Pass it as <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">Authorization: Bearer KEY</code></p>
  <div class="flex gap-3 items-center">
    <code class="flex-1 bg-gray-100 dark:bg-gray-800 rounded-lg px-4 py-3 text-sm font-mono break-all" id="api-key-val">{{ api_key }}</code>
    <button onclick="navigator.clipboard.writeText('{{ api_key }}').then(()=>this.textContent='Copied!')"
      class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 whitespace-nowrap">Copy</button>
  </div>
  <form method="post" action="{{ url('dashboard:api-key-regenerate') }}" class="mt-4"
        onsubmit="return confirm('Regenerate? The old key will stop working immediately.')">
    <input type="hidden" name="csrfmiddlewaretoken" value="{{ get_csrf(request) }}">
    <button type="submit" class="text-sm text-red-500 hover:text-red-700">Regenerate API key</button>
  </form>
</div>

<div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 p-6">
  <h2 class="text-lg font-semibold mb-3">Quick Start</h2>
  <pre class="bg-gray-900 text-green-300 rounded-xl p-4 text-sm overflow-x-auto">curl -X POST \
  -H "Authorization: Bearer {{ api_key }}" \
  -F "tool=compress-pdf" \
  -F "files=@document.pdf" \
  https://sdtoolx.com/api/v1/jobs/</pre>
  <a href="/api/docs/" class="mt-4 inline-block text-indigo-600 hover:underline text-sm">Full API documentation →</a>
</div>

{% else %}
<div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-2xl p-8 text-center">
  <h2 class="text-xl font-semibold mb-2">API access requires Business plan</h2>
  <p class="text-gray-600 dark:text-gray-400 mb-4">Upgrade to Business (₹799/mo) to get your API key and integrate SD-Toolx into your workflow.</p>
  <a href="/pricing/" class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700">
    Upgrade to Business
  </a>
</div>
{% endif %}
{% endblock %}
