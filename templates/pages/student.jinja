{% extends "layouts/marketing.jinja" %}
{% block title %}Student discount — {{ site_name }}{% endblock %}
{% block content %}
<div class="max-w-md mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold mb-2">50% off for students</h1>
  <p class="text-gray-500 mb-6">Use your college email (.edu or .ac.in)</p>
  {% if message %}
  <p class="mb-4 text-sm text-indigo-600">{{ message }}</p>
  {% endif %}
  <form method="post" class="space-y-4">
    <input type="hidden" name="csrfmiddlewaretoken" value="{{ get_csrf(request) }}">
    <input type="email" name="email" required placeholder="you@college.edu"
      class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
    <button type="submit" class="w-full bg-indigo-600 text-white py-2.5 rounded-lg font-medium">Verify student email</button>
  </form>
  <a href="{{ url('billing:pricing') }}" class="block text-center mt-6 text-sm text-indigo-600">View pricing</a>
</div>
{% endblock %}
