{% extends "layouts/marketing.jinja" %}
{% block title %}Blog — Tips, Guides & Updates — {{ site_name }}{% endblock %}
{% block meta_description %}Tutorials, tips, and updates about PDF tools, image editing, and productivity workflows. Free guides from {{ site_name }}.{% endblock %}

{% block extra_head %}
<style>
  @keyframes fade-up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
  .animate-in { animation: fade-up .4s ease both; }
  .post-card { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .post-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(99,102,241,.12); border-color: rgba(99,102,241,.35) !important; }
  .dark .post-card:hover { box-shadow: 0 12px 32px rgba(99,102,241,.2); }
  .tag-pill { transition: background .15s, color .15s; }
  .tag-pill:hover { background: #4f46e5; color: #fff; }
</style>
{% endblock %}

{% block content %}

{# ── HERO ─────────────────────────────────────────────────────────────────── #}
<div class="border-b border-gray-100 dark:border-gray-800 bg-gradient-to-b from-indigo-50/60 dark:from-indigo-950/20 to-transparent pt-14 pb-10 px-4">
  <div class="max-w-3xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 bg-white dark:bg-gray-900 border border-indigo-100 dark:border-indigo-900 rounded-full px-4 py-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-5 shadow-sm">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Guides, Tips & Updates
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
      The <span style="background:linear-gradient(135deg,#6366f1,#8b5cf6,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">{{ site_name }}</span> Blog
    </h1>
    <p class="text-gray-500 dark:text-gray-400 text-lg max-w-xl mx-auto">Tutorials, tips, and best practices for working with PDFs, images, and documents.</p>
  </div>
</div>

{# ── CONTENT ──────────────────────────────────────────────────────────────── #}
<div class="max-w-4xl mx-auto px-4 py-12">

  {% if posts %}

  {# Featured post (first) #}
  {% set featured = posts[0] %}
  <a href="{{ url('blog:detail', args=[featured.slug]) }}"
     class="post-card group block bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm mb-8 animate-in">
    <div class="p-8 md:p-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold uppercase tracking-widest px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400">Featured</span>
        {% if featured.published_at %}
        <span class="text-sm text-gray-400 dark:text-gray-500">{{ featured.published_at|date('F j, Y') }}</span>
        {% endif %}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-gray-100 mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">{{ featured.title }}</h2>
      {% if featured.meta_description %}
      <p class="text-gray-500 dark:text-gray-400 text-base leading-relaxed mb-5 line-clamp-2">{{ featured.meta_description }}</p>
      {% endif %}
      <div class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
        Read article
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </div>
    </div>
  </a>

  {# Rest of posts grid #}
  {% if posts|length > 1 %}
  <div class="grid sm:grid-cols-2 gap-5">
    {% for post in posts %}
    {% if loop.index0 > 0 %}
    <a href="{{ url('blog:detail', args=[post.slug]) }}"
       class="post-card group bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-6 flex flex-col gap-3 shadow-sm animate-in"
       style="animation-delay: {{ (loop.index0 - 1) * 60 }}ms">
      <div class="flex items-center gap-2 mb-1">
        {% if post.published_at %}
        <span class="text-xs text-gray-400 dark:text-gray-500">{{ post.published_at|date('M j, Y') }}</span>
        {% endif %}
      </div>
      <h2 class="font-bold text-gray-900 dark:text-gray-100 text-base leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{{ post.title }}</h2>
      {% if post.meta_description %}
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed line-clamp-2 flex-1">{{ post.meta_description }}</p>
      {% endif %}
      <div class="flex items-center gap-1 text-xs font-semibold text-indigo-500 dark:text-indigo-400 mt-1">
        Read more
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    </a>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {% else %}

  {# ── EMPTY STATE ─────────────────────────────────────────────────────────── #}
  <div class="text-center py-20 animate-in">
    <div class="w-20 h-20 rounded-3xl bg-gradient-to-br from-indigo-100 to-violet-100 dark:from-indigo-950/60 dark:to-violet-950/60 flex items-center justify-center mx-auto mb-6 shadow-inner">
      <svg class="w-10 h-10 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">Articles coming soon</h2>
    <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto mb-8">We're working on guides and tutorials to help you get the most out of {{ site_name }}.</p>
    <a href="{{ url('tools:index') }}"
       class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all">
      Explore our tools
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>

  {% endif %}

</div>

{# ── CTA STRIP ─────────────────────────────────────────────────────────────── #}
<div class="border-t border-gray-100 dark:border-gray-800 bg-gradient-to-r from-indigo-50 via-violet-50/50 to-cyan-50/30 dark:from-indigo-950/20 dark:via-violet-950/10 dark:to-transparent py-14 px-4">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-3">Ready to try {{ site_name }}?</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-6">{{ tools_count|default('') }} free tools. No signup needed.</p>
    <a href="{{ url('tools:index') }}"
       class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3 rounded-xl shadow-sm hover:shadow-indigo-500/25 transition-all">
      Browse all tools
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</div>

{% endblock %}
