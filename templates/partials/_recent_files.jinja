{% if jobs %}
<div class="mt-8 border-t border-gray-200 dark:border-gray-800 pt-8">
  <h3 class="text-sm font-semibold text-gray-500 mb-3">Your recent files (24h)</h3>
  <ul class="space-y-2">
    {% for job in jobs %}
    <li class="flex justify-between text-sm border border-gray-200 dark:border-gray-800 rounded-lg px-4 py-2">
      <span>{{ job.tool_slug }}</span>
      <a href="{{ url('tools:job-download', args=[job.id]) }}" class="text-indigo-600 hover:underline">Download</a>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
